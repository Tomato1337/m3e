{
  "name": "@tomato1337/m3e-tokens",
  "version": "0.2.0",
  "type": "module",
  "description": "Material 3 Expressive design tokens: CSS custom properties, spring easings, dynamic color.",
  "license": "MIT",
  "author": "Ilya Tyunin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tomato1337/m3e.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/Tomato1337/m3e#readme",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "css",
    "src"
  ],
  "exports": {
    ".": {
      "m3e-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./css/tokens.css",
    "./tailwind.css": "./css/tailwind.css"
  },
  "scripts": {
    "gen": "tsx scripts/gen.ts",
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
