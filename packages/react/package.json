{
  "name": "@tomato1337/m3e-react",
  "version": "0.4.0",
  "type": "module",
  "description": "Material 3 Expressive React components with enter/exit motion, built on native dialog/popover.",
  "license": "MIT",
  "author": "Ilya Tyunin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tomato1337/m3e.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Tomato1337/m3e#readme",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "exports": {
    ".": {
      "m3e-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@tomato1337/m3e-tokens": "0.4.0",
    "@material-symbols/font-400": "^0.48.2"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "publishConfig": {
    "access": "public"
  }
}
